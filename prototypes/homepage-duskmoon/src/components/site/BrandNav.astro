<header class="nav" data-nav>
  <nav class="nav__inner" aria-label="全站导航">
    <div class="nav__brand-group">
      <a class="nav__brand" href="/" aria-label="LunaDeerMC 首页">LunaDeerMC</a>
      <a class="nav__link nav__link--organization" href="/support">支持</a>
      <a class="nav__link nav__link--organization" href="/about">关于</a>
    </div>

    <div class="nav__content-group">
      <a class="nav__link nav__link--content" href="/works">作品</a>
      <a class="nav__link nav__link--content" href="/docs">文档</a>
      <button class="nav__menu" type="button" aria-label="打开功能菜单" aria-expanded="false" aria-controls="site-tools">
        <span></span><span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <div class="nav-panel" id="site-tools" hidden>
    <div class="nav-panel__group nav-panel__group--organization">
      <span>组织</span>
      <a href="/support">支持</a>
      <a href="/about">关于</a>
    </div>
    <div class="nav-panel__group nav-panel__group--content">
      <span>内容</span>
      <a href="/works">作品</a>
      <a href="/docs">文档</a>
    </div>
    <div class="nav-panel__group">
      <span>工具</span>
      <button type="button" disabled>搜索站内内容</button>
      <div class="nav-panel__language" aria-label="语言">
        <strong>中文</strong>
        <a href="/en">English</a>
      </div>
    </div>
  </div>
</header>

<script>
  const trigger = document.querySelector<HTMLButtonElement>(".nav__menu");
  const panel = document.querySelector<HTMLElement>("#site-tools");

  if (trigger && panel) {
    const close = () => {
      panel.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
    };

    trigger.addEventListener("click", () => {
      const willOpen = panel.hidden;
      panel.hidden = !willOpen;
      trigger.setAttribute("aria-expanded", String(willOpen));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        close();
        trigger.focus();
      }
    });

    document.addEventListener("pointerdown", (event) => {
      if (!panel.hidden && event.target instanceof Node && !panel.contains(event.target) && !trigger.contains(event.target)) {
        close();
      }
    });
  }
</script>

