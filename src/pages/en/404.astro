---
import { ArrowLeft, BookOpen, Search } from "lucide-astro";
import { withLocale } from "../../i18n/common";
import SiteLayout from "../../layouts/SiteLayout.astro";

const locale = "en" as const;
---
<SiteLayout title="Page not found" description="The requested LunaDeerMC page does not exist." locale={locale} currentPath="/en/404" contentPage>
  <div class="not-found page-grid"><p class="not-found__code">404</p><h1>We couldn't find that page.</h1><p>The link may have changed, or the page is not published in this language.</p><div class="not-found__actions"><a class="button button--primary" href={withLocale(locale, "/")}><ArrowLeft size={17} />Back home</a><a class="button button--outline" href={withLocale(locale, "/docs")}><BookOpen size={17} />View docs</a><button class="button button--quiet" type="button" data-open-search><Search size={17} />Search</button></div></div>
</SiteLayout>
