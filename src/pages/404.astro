---
import { ArrowLeft, BookOpen, Search } from "lucide-astro";
import { withLocale } from "../i18n/common";
import SiteLayout from "../layouts/SiteLayout.astro";

const locale = "zh-CN" as const;
---
<SiteLayout title="没有找到这个页面" description="请求的 LunaDeerMC 页面不存在。" locale={locale} currentPath="/404" contentPage>
  <div class="not-found page-grid"><p class="not-found__code">404</p><h1>没有找到这个页面。</h1><p>链接可能已经改变，或者这个页面还没有在当前语言发布。</p><div class="not-found__actions"><a class="button button--primary" href={withLocale(locale, "/")}><ArrowLeft size={17} />返回首页</a><a class="button button--outline" href={withLocale(locale, "/docs")}><BookOpen size={17} />查看文档</a><button class="button button--quiet" type="button" data-open-search><Search size={17} />搜索</button></div></div>
</SiteLayout>
