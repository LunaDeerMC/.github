---
import { ArrowDown, ArrowRight } from "lucide-astro";
import { commonCopy, type Locale, withLocale } from "../../i18n/common";
import { avifAssetPath, type SiteConfig } from "../../lib/site";

interface Props {
  locale: Locale;
  site: SiteConfig;
}

const { locale, site } = Astro.props;
const copy = commonCopy[locale];
const sceneLayers = [
  { name: "sky", depth: 8 },
  { name: "distance", depth: 5 },
  { name: "settlement", depth: 2 },
  { name: "foreground", depth: 1 },
] as const;

function sceneImageValue(src: string) {
  if (!import.meta.env.PROD) return `url('${src}')`;
  return `image-set(url('${avifAssetPath(src)}') type("image/avif"), url('${src}') type("image/webp"))`;
}
---

<section class="home-hero" id="top" data-parallax-hero aria-labelledby="home-title">
  <div class="home-hero__viewport">
    <div class="home-scene" aria-hidden="true">
      {(["light", "dark"] as const).map((theme) => (
        <div class:list={["scene-stack", `scene-stack--${theme}`]}>
          {sceneLayers.map((layer) => (
            <div
              class:list={["scene-layer", `scene-layer--${layer.name}`]}
              data-depth={layer.depth}
              data-parallax-layer={layer.name}
              style={`--scene-depth: ${layer.depth}; --scene-image: ${sceneImageValue(site.scenes[theme].layers[layer.name])}`}
            ></div>
          ))}
          <div class="scene-fade"></div>
        </div>
      ))}
    </div>
    <div class="home-hero__inner page-grid">
      <div class="home-hero__copy" data-hero-copy>
        <h1 id="home-title">LunaDeerMC</h1>
        <p class="home-hero__slogan">{site.slogan}</p>
        <p class="home-hero__description">
          {locale === "en" ? "Reliable plugins, server cores, and developer tools for the Minecraft community." : "为 Minecraft 社区构建可靠易用的插件、服务端核心与开发工具。"}
        </p>
        <div class="home-hero__actions">
          <a class="button button--primary" href={withLocale(locale, "/works")}>{locale === "en" ? "Browse works" : "浏览作品"}<ArrowDown size={17} /></a>
          <a class="button button--quiet" href={withLocale(locale, "/docs")}>{copy.actions.readDocs}<ArrowRight size={17} /></a>
        </div>
      </div>
    </div>
    <a class="home-hero__scroll-cue" href="#featured" aria-label={locale === "en" ? "Scroll to selected works" : "向下查看精选作品"}>
      <span>{locale === "en" ? "Selected work" : "精选作品"}</span><ArrowDown size={16} />
    </a>
  </div>
</section>

<script is:inline data-astro-rerun>
  (() => {
    const hero = document.querySelector('[data-parallax-hero]');
    if (!hero || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const controller = new AbortController();
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });
    let ticking = false;
    const update = () => {
      const rect = hero.getBoundingClientRect();
      const distance = Math.min(1, Math.max(0, -rect.top / Math.max(rect.height, 1)));
      hero.style.setProperty('--parallax-progress', String(distance));
      hero.style.setProperty('--hero-copy-exit', String(Math.min(1, distance * 2.4)));
      ticking = false;
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    update();
    window.addEventListener('scroll', onScroll, { passive: true, signal: controller.signal });
  })();
</script>
