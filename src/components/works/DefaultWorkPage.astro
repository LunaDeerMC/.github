---
import { ArrowRight, ArrowUpRight, Check, ExternalLink, Maximize2, X } from "lucide-astro";
import { commonCopy, localize, type Locale, withLocale } from "../../i18n/common";
import type { WorkPageRecord, WorkRecord } from "../../lib/content/types";
import LunaIcon from "../shared/LunaIcon.astro";

interface Props {
  locale: Locale;
  work: WorkRecord;
  page: WorkPageRecord;
  Content: any;
}

const { locale, work, page, Content } = Astro.props;
const copy = commonCopy[locale];
const lifecycle = copy.status[work.lifecycle === "early-access" ? "earlyAccess" : work.lifecycle === "archived" ? "archived" : "active"];
const access = copy.status[work.accessModel];
const docsUrl = work.docs ? withLocale(locale, `/docs/${work.docs.root}`) : "";
const linkLabels = { source: locale === "en" ? "Source" : "源码", issues: locale === "en" ? "Issues" : "问题反馈", support: locale === "en" ? "Support" : "支持", community: locale === "en" ? "Community" : "社区", other: "" };
const galleryItems = page.gallery.map((item) => ({
  ...item,
  alt: localize(item.alt, locale),
  title: item.title ? localize(item.title, locale) : "",
  description: item.description ? localize(item.description, locale) : "",
}));
---

<div class="work-page page-grid" data-work-page>
  <header class="work-page__header">
    <div class="work-page__identity"><div class="work-page__icon">{work.iconSrc ? <img class="work-icon-image" src={work.iconSrc} alt="" loading="lazy" decoding="async" aria-hidden="true" /> : <LunaIcon name={work.icon} size={31} strokeWidth={1.5} />}</div><div><p class="eyebrow">{copy.types[work.type]}</p><h1>{work.name}</h1><p class="work-page__summary">{localize(work.summary, locale)}</p><div class="work-page__badges"><span>{lifecycle}</span><span>{access}</span></div></div></div>
    {docsUrl && <a class="button button--primary" href={docsUrl}>{copy.actions.viewDocs}<ArrowRight size={17} /></a>}
  </header>

  <div class="work-tabs" role="tablist" aria-label={locale === "en" ? "Work sections" : "作品区块"}>
    <button class="is-active" id="work-tab-intro" role="tab" aria-selected="true" aria-controls="work-panel-intro" data-work-tab="intro">{locale === "en" ? "Introduction" : "介绍"}</button>
    {page.gallery.length > 0 && <button id="work-tab-gallery" role="tab" aria-selected="false" aria-controls="work-panel-gallery" data-work-tab="gallery">{locale === "en" ? "Gallery" : "图库"}</button>}
    {page.github && <button id="work-tab-releases" role="tab" aria-selected="false" aria-controls="work-panel-releases" data-work-tab="releases">{locale === "en" ? "Versions & updates" : "版本与更新"}</button>}
    {page.acquisition.length > 0 && <button id="work-tab-acquisition" role="tab" aria-selected="false" aria-controls="work-panel-acquisition" data-work-tab="acquisition">{locale === "en" ? "Get the work" : "获取方式"}</button>}
  </div>

  <div class="work-page__layout">
    <div class="work-page__main">
      <section class="work-panel is-active" id="work-panel-intro" data-work-panel="intro" role="tabpanel" aria-labelledby="work-tab-intro"><div class="markdown-body"><Content /></div></section>
      {galleryItems.length > 0 && <section class="work-panel" id="work-panel-gallery" data-work-panel="gallery" role="tabpanel" aria-labelledby="work-tab-gallery" hidden>
        <div class="gallery-grid">
          {galleryItems.map((item) => <figure class="gallery-item">
            <button
              class="gallery-item__trigger"
              type="button"
              data-gallery-trigger
              data-gallery-src={item.src}
              data-gallery-alt={item.alt}
              data-gallery-title={item.title}
              data-gallery-description={item.description}
              aria-label={locale === "en" ? `Open ${item.title || "image"} in full size` : `放大查看${item.title || "图片"}`}
            >
              <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
              <span class="gallery-item__zoom" aria-hidden="true"><Maximize2 size={17} /></span>
            </button>
            <figcaption>{item.title && <strong>{item.title}</strong>}{item.description && <span>{item.description}</span>}</figcaption>
          </figure>)}
        </div>
        <dialog class="gallery-lightbox" data-gallery-lightbox aria-label={locale === "en" ? "Image preview" : "图片预览"}>
          <div class="gallery-lightbox__surface">
            <button class="gallery-lightbox__close" type="button" data-gallery-close aria-label={locale === "en" ? "Close image preview" : "关闭图片预览"}><X size={19} /></button>
            <figure>
              <img data-gallery-lightbox-image alt="" decoding="async" />
              <figcaption data-gallery-lightbox-caption hidden><strong data-gallery-lightbox-title hidden></strong><span data-gallery-lightbox-description hidden></span></figcaption>
            </figure>
          </div>
        </dialog>
      </section>}
      {page.github && <section class="work-panel" id="work-panel-releases" data-work-panel="releases" role="tabpanel" aria-labelledby="work-tab-releases" hidden data-releases data-github={page.github}><div class="releases-loading">{locale === "en" ? "Loading public releases…" : "正在加载公开版本……"}</div><noscript><a class="text-link" href={`${page.github}/releases`}>{locale === "en" ? "Open GitHub releases" : "打开 GitHub Releases"}<ExternalLink size={15} /></a></noscript></section>}
      {page.acquisition.length > 0 && <section class="work-panel" id="work-panel-acquisition" data-work-panel="acquisition" role="tabpanel" aria-labelledby="work-tab-acquisition" hidden><div class="acquisition-list">{page.acquisition.map((option) => <article class:list={["acquisition-option", { "is-recommended": option.recommended }]}><div class="acquisition-option__top"><div><p class="eyebrow">{option.access === "paid" ? copy.status.paid : copy.status.free}</p><h2>{localize(option.name, locale)}</h2></div>{option.priceText && <strong class="acquisition-option__price">{localize(option.priceText, locale)}</strong>}</div><p>{localize(option.description, locale)}</p>{option.benefits && <ul>{option.benefits.map((benefit) => <li><Check size={15} />{localize(benefit, locale)}</li>)}</ul>}<div class="acquisition-option__channels">{option.channels.map((channel) => { const href = channel.url.startsWith("/") ? withLocale(locale, channel.url) : channel.url; return <a class="button button--outline" href={href} target={href.startsWith("http") ? "_blank" : undefined} rel={href.startsWith("http") ? "noreferrer" : undefined}>{channel.actionLabel ? localize(channel.actionLabel, locale) : option.access === "paid" ? (locale === "en" ? "Get access" : "获取授权") : (locale === "en" ? "Download" : "前往下载")}<ArrowUpRight size={15} /></a>; })}</div></article>)}</div></section>}
    </div>
    <aside class="work-page__aside">
      <div class="work-page__mini-header" data-work-mini-header hidden aria-hidden="true">
        <div class="work-page__mini-copy">
          <p class="eyebrow">{copy.types[work.type]}</p>
          <h2>{work.name}</h2>
          <p class="work-page__mini-summary">{localize(work.summary, locale)}</p>
          <div class="work-page__mini-badges"><span>{lifecycle}</span><span>{access}</span></div>
          {docsUrl && <a class="work-page__mini-docs" href={docsUrl}>{copy.actions.viewDocs}<ArrowRight size={14} /></a>}
        </div>
      </div>
      <section class="compatibility-section"><p class="eyebrow">{locale === "en" ? "Compatibility" : "兼容性"}</p>
        {work.compatibility?.minecraft && <div class="compatibility-group"><strong class="compatibility-group__label">{locale === "en" ? "Supported versions" : "适配版本"}</strong><div class="compatibility-group__values">{work.compatibility.minecraft.map((item) => <span>{item}</span>)}</div></div>}
        {work.compatibility?.platforms && <div class="compatibility-group"><strong class="compatibility-group__label">{locale === "en" ? "Platforms" : "平台"}</strong><div class="compatibility-group__values">{work.compatibility.platforms.map((item) => <span>{item}</span>)}</div></div>}
      </section>
      {page.links.length > 0 && <section><p class="eyebrow">{locale === "en" ? "Related links" : "相关链接"}</p>{page.links.map((link) => { const href = link.url.startsWith("/") ? withLocale(locale, link.url) : link.url; return <a class="aside-link" href={href} target={href.startsWith("http") ? "_blank" : undefined} rel={href.startsWith("http") ? "noreferrer" : undefined}><LunaIcon name={link.icon ?? (link.type === "source" ? "Code2" : link.type === "issues" ? "CircleAlert" : link.type === "support" ? "Heart" : "ExternalLink")} size={16} /><span>{link.type === "other" && link.label ? localize(link.label, locale) : linkLabels[link.type]}</span><ArrowUpRight size={14} /></a>; })}</section>}
      <section><p class="eyebrow">{locale === "en" ? "Work information" : "作品信息"}</p><div class="info-line"><span>{locale === "en" ? "Published" : "发布"}</span><strong>{work.publishedAt}</strong></div>{page.license && <div class="info-line"><span>{locale === "en" ? "License" : "授权"}</span><strong>{page.license.name}</strong></div>}{work.lifecycle === "archived" && work.archive?.replacement && <a class="aside-link" href={withLocale(locale, `/works/${work.archive.replacement}`)}><span>{locale === "en" ? "See the replacement" : "查看替代作品"}</span><ArrowRight size={14} /></a>}</section>
    </aside>
  </div>
</div>

<script is:inline data-astro-rerun>
  (() => {
    const root = document.querySelector('[data-work-page]');
    if (!root) return;
    const controller = new AbortController();
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });
    const on = (target, type, handler, options = {}) => target?.addEventListener(type, handler, { ...options, signal: controller.signal });
    const buttons = [...root.querySelectorAll('[data-work-tab]')];
    const panels = [...root.querySelectorAll('[data-work-panel]')];
    const header = root.querySelector('.work-page__header');
    const miniHeader = root.querySelector('[data-work-mini-header]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    let headerCollapsed = false;
    let headerFrame = null;
    const getNavHeight = () => parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-height')) || 72;
    const updateHeaderCollapse = () => {
      if (!header || !miniHeader) return;
      const mobile = window.matchMedia('(max-width: 760px)').matches;
      const collapsed = !mobile && header.getBoundingClientRect().bottom <= getNavHeight() + 12;
      if (collapsed === headerCollapsed) return;
      headerCollapsed = collapsed;
      root.classList.toggle('is-header-collapsed', collapsed);
      miniHeader.setAttribute('aria-hidden', String(!collapsed));
      header.inert = collapsed;
    };
    if (miniHeader) {
      miniHeader.hidden = false;
      updateHeaderCollapse();
      on(window, 'scroll', () => {
        if (headerFrame) return;
        headerFrame = window.requestAnimationFrame(() => {
          headerFrame = null;
          updateHeaderCollapse();
        });
      }, { passive: true });
      on(window, 'resize', updateHeaderCollapse);
    }

    let isSwitching = false;
    const selectTab = (button, focus = false) => {
      if (!button || isSwitching) return;
      const tab = button.dataset.workTab;
      const activeButton = buttons.find((item) => item.getAttribute('aria-selected') === 'true');
      const activePanel = panels.find((panel) => !panel.hidden);
      const nextPanel = panels.find((panel) => panel.dataset.workPanel === tab);
      if (!nextPanel || button === activeButton) {
        if (focus) button.focus();
        return;
      }
      isSwitching = true;
      const finish = () => {
        buttons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-selected', String(active));
          item.tabIndex = active ? 0 : -1;
        });
        panels.forEach((panel) => {
          if (panel === nextPanel) {
            panel.hidden = false;
            panel.classList.remove('is-active', 'is-leaving');
            void panel.offsetWidth;
            panel.classList.add('is-active');
          } else {
            panel.hidden = true;
            panel.classList.remove('is-active', 'is-leaving');
          }
        });
        isSwitching = false;
      };
      if (activePanel && activePanel !== nextPanel && !reducedMotion.matches) {
        activePanel.classList.add('is-leaving');
        window.setTimeout(finish, 150);
      } else {
        finish();
      }
      if (focus) button.focus();
    };

    buttons.forEach((button, index) => {
      button.tabIndex = button.classList.contains('is-active') ? 0 : -1;
      on(button, 'click', () => selectTab(button));
      on(button, 'keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        let nextIndex = index;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % buttons.length;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + buttons.length) % buttons.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = buttons.length - 1;
        selectTab(buttons[nextIndex], true);
      });
    });
    const lightbox = root.querySelector('[data-gallery-lightbox]');
    const galleryTriggers = [...root.querySelectorAll('[data-gallery-trigger]')];
    if (lightbox && galleryTriggers.length) {
      const image = lightbox.querySelector('[data-gallery-lightbox-image]');
      const caption = lightbox.querySelector('[data-gallery-lightbox-caption]');
      const title = lightbox.querySelector('[data-gallery-lightbox-title]');
      const description = lightbox.querySelector('[data-gallery-lightbox-description]');
      const closeButton = lightbox.querySelector('[data-gallery-close]');
      let activeTrigger = null;
      const closeLightbox = () => {
        if (typeof lightbox.close === 'function' && lightbox.open) lightbox.close();
        else lightbox.removeAttribute('open');
      };
      const updateCaption = (value, element) => {
        if (!element) return;
        element.textContent = value || '';
        element.hidden = !value;
      };
      galleryTriggers.forEach((trigger) => trigger.addEventListener('click', () => {
        activeTrigger = trigger;
        if (image) { image.src = trigger.dataset.gallerySrc || ''; image.alt = trigger.dataset.galleryAlt || ''; }
        updateCaption(trigger.dataset.galleryTitle, title);
        updateCaption(trigger.dataset.galleryDescription, description);
        if (caption) caption.hidden = !trigger.dataset.galleryTitle && !trigger.dataset.galleryDescription;
        if (typeof lightbox.showModal === 'function') lightbox.showModal();
        else lightbox.setAttribute('open', '');
        closeButton?.focus();
      }));
      closeButton?.addEventListener('click', closeLightbox);
      lightbox.addEventListener('click', (event) => { if (event.target === lightbox) closeLightbox(); });
      lightbox.addEventListener('close', () => { activeTrigger?.focus(); activeTrigger = null; });
    }
    const release = root.querySelector('[data-releases]');
    if (release) {
      const github = release.dataset.github.replace('https://github.com/', '').replace(/\/$/, '').replace(/\.git$/, '');
      const locale = document.documentElement.lang === 'en' ? 'en' : 'zh-CN';
      const cacheKey = `lunadeer-release:${github}`;
      const cached = sessionStorage.getItem(cacheKey);
      const render = (releases) => { if (!releases.length) { release.innerHTML = `<a class="text-link" href="https://github.com/${github}/releases" target="_blank" rel="noreferrer">${locale === 'en' ? 'Open GitHub releases' : '打开 GitHub Releases'} ↗</a>`; return; } release.innerHTML = `<div class="release-list">${releases.slice(0, 6).map((item) => `<a class="release-row" href="${item.html_url}" target="_blank" rel="noreferrer"><span><strong>${item.name || item.tag_name}</strong><small>${item.tag_name} · ${item.published_at?.slice(0, 10) || ''}</small></span><span>↗</span></a>`).join('')}</div>`; };
      if (cached) { try { render(JSON.parse(cached)); } catch {} } else { fetch(`https://api.github.com/repos/${github}/releases?per_page=6`, { headers: { Accept: 'application/vnd.github+json' } }).then((response) => response.ok ? response.json() : []).then((data) => { const releases = Array.isArray(data) ? data.filter((item) => !item.draft) : []; sessionStorage.setItem(cacheKey, JSON.stringify(releases)); render(releases); }).catch(() => render([])); }
    }
  })();
</script>
