---
import { ArrowRight, Search } from "lucide-astro";
import { commonCopy, type Locale, withLocale } from "../../i18n/common";
import type { DocumentSetRecord } from "../../lib/content/types";
import LunaIcon from "../shared/LunaIcon.astro";

interface Props { locale: Locale; sets: DocumentSetRecord[]; category?: string; }
const { locale, sets, category = "all" } = Astro.props;
const copy = commonCopy[locale];
const categories = [
  ["all", locale === "en" ? "All docs" : "全部", "LayoutGrid"],
  ["plugins", copy.types.plugin, "Puzzle"],
  ["cores", copy.types.core, "Boxes"],
  ["tools", locale === "en" ? "Developer tools" : "开发工具", "Code2"],
  ["general", locale === "en" ? "General docs" : "通用文档", "FileText"],
] as const;
const titles = category === "all" ? (locale === "en" ? ["Documentation", "Find installation, configuration, and usage notes."] : ["文档", "查找安装、配置与使用说明。"]) : (locale === "en" ? [categories.find(([id]) => id === category)?.[1] ?? "Documentation", "Browse the document sets in this category."] : [categories.find(([id]) => id === category)?.[1] ?? "文档", "浏览当前分类下的文档集。"]);
const visibleSets = sets.filter((set) => category === "all" || set.category === category);
---

<div class="docs-directory page-grid">
  <aside class="docs-directory__aside"><p class="eyebrow">Documentation</p><h1>{titles[0]}</h1><p>{locale === "en" ? "A readable index for the work we build and the systems around it." : "为 LunaDeerMC 的作品与周边系统提供一份可阅读的文档索引。"}</p><nav class="docs-categories" aria-label={locale === "en" ? "Documentation categories" : "文档分类"}>{categories.map(([id, label, icon]) => <a class:list={[{ "is-active": category === id }]} href={id === "all" ? withLocale(locale, "/docs") : withLocale(locale, `/docs/${id}`)}><LunaIcon name={icon} size={19} /><span>{label}</span><small>{id === "all" ? sets.length : sets.filter((set) => set.category === id).length}</small></a>)}</nav></aside>
  <section class="docs-directory__main"><header class="docs-directory__heading"><div><p class="eyebrow">{category === "all" ? (locale === "en" ? "All docs" : "全部文档") : titles[0]}</p><h2>{titles[1]}</h2></div><button class="docs-search-button" type="button" data-open-search><Search size={18} />{locale === "en" ? "Search docs" : "搜索文档……"}<kbd>/</kbd></button></header><div class="document-table" role="table"><div class="document-table__head" role="row"><span>{locale === "en" ? "Document set" : "文档集"}</span><span>{locale === "en" ? "Category" : "分类"}</span><span>{locale === "en" ? "Languages" : "语言"}</span><span>{locale === "en" ? "Status" : "状态"}</span><span aria-hidden="true"></span></div>{visibleSets.map((set, index) => <a class="document-row" role="row" href={withLocale(locale, set.root.url)} data-reveal="up" style={`--reveal-delay: ${index * 80}ms`}><span class="document-row__title"><LunaIcon name={set.root.icon ?? "FileText"} size={24} /><span class="document-row__title-copy"><strong>{set.root.title}</strong><small>{set.root.description}</small></span></span><span class="document-row__category">{categories.find(([id]) => id === set.category)?.[1]}</span><span class="document-row__languages">{locale === "en" ? "English" : "简体中文"}{set.pages.some((page) => page.locale !== locale) ? " · " + (locale === "en" ? "中文" : "English") : ""}</span><span class="document-row__status">{set.status === "archived" ? copy.status.archived : (locale === "en" ? "Active" : "最新")}</span><ArrowRight size={18} /></a>)}</div></section>
</div>
