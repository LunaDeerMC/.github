---
import { Search, SlidersHorizontal } from "lucide-astro";
import { commonCopy, type Locale } from "../../i18n/common";
import type { SearchRecord } from "../../lib/content/types";

interface Props { locale: Locale; records: SearchRecord[]; query: string; }
const { locale, records, query } = Astro.props;
const copy = commonCopy[locale];
---

<div class="search-page page-grid" data-full-search>
  <header class="page-intro"><p class="eyebrow">Search</p><h1>{locale === "en" ? "Search the site" : "搜索站内内容"}</h1><p>{locale === "en" ? "Find works, docs, and the few pages that keep the whole site connected." : "查找作品、文档，以及把整个站点连接起来的少量页面。"}</p></header>
  <form class="full-search-form" data-full-search-form><Search size={20} /><input type="search" name="q" value={query} placeholder={locale === "en" ? "Search works and docs…" : "搜索作品与文档……"} autocomplete="off" /><button type="submit">{copy.actions.search}</button></form>
  <div class="full-search-meta"><span data-full-search-count>{query ? "" : (locale === "en" ? "Start with a word or a project name." : "输入关键词，开始搜索。")}</span><div class="search-scopes" role="tablist"><button type="button" class="is-active" data-full-scope="all">{locale === "en" ? "All content" : "全部内容"}</button><button type="button" data-full-scope="docs">{locale === "en" ? "Docs" : "文档"}</button><button type="button" data-full-scope="works">{locale === "en" ? "Works" : "作品"}</button></div></div>
  <div class="full-search-results" data-full-search-results>{query ? <p class="search-empty">{locale === "en" ? "Searching…" : "正在搜索……"}</p> : <div class="empty-state empty-state--quiet"><SlidersHorizontal size={24} /><p>{locale === "en" ? "Search results will appear here." : "搜索结果会显示在这里。"}</p></div>}</div>
  <script is:inline type="application/json" data-full-search-index set:html={JSON.stringify(records)}></script>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-full-search]');
    if (!root) return;
    const locale = document.documentElement.lang === 'en' ? 'en' : 'zh-CN';
    const input = root.querySelector('input[name="q"]');
    const form = root.querySelector('[data-full-search-form]');
    const results = root.querySelector('[data-full-search-results]');
    const count = root.querySelector('[data-full-search-count]');
    const raw = root.querySelector('[data-full-search-index]');
    const index = raw ? JSON.parse(raw.textContent || '[]') : [];
    const initialQuery = new URL(window.location.href).searchParams.get('q') || '';
    if (input && !input.value && initialQuery) input.value = initialQuery;
    let scope = 'all';
    const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[char]);
    const matchesScope = (item) => scope === 'all' || (scope === 'works' ? item.url.includes('/works/') : item.url.includes('/docs/'));
    function render() {
      const query = input.value.trim().toLowerCase();
      const found = index.filter((item) => matchesScope(item) && query && `${item.title} ${item.summary} ${item.category || ''} ${item.documentSet || ''}`.toLowerCase().includes(query));
      count.textContent = query ? `${found.length} ${locale === 'en' ? 'results' : '条结果'}` : (locale === 'en' ? 'Start with a word or a project name.' : '输入关键词，开始搜索。');
      if (!query) { results.innerHTML = `<div class="empty-state empty-state--quiet"><p>${locale === 'en' ? 'Search results will appear here.' : '搜索结果会显示在这里。'}</p></div>`; return; }
      if (!found.length) { results.innerHTML = `<div class="empty-state"><p>${locale === 'en' ? 'No matching content.' : '没有找到匹配内容。'}</p><button class="text-link" type="button" data-clear-full>${locale === 'en' ? 'Clear search' : '清除搜索'}</button></div>`; results.querySelector('[data-clear-full]').addEventListener('click', () => { input.value = ''; render(); input.focus(); }); return; }
      results.innerHTML = found.map((item) => `<a class="full-search-result" href="${item.url}"><span class="search-result__type">${escapeHtml(item.type)}${item.category ? ` · ${escapeHtml(item.category)}` : ''}</span><h2>${escapeHtml(item.title)}</h2><p>${escapeHtml(item.summary || '')}</p><span class="search-result__arrow">→</span></a>`).join('');
    }
    form.addEventListener('submit', (event) => { event.preventDefault(); const url = new URL(window.location.href); if (input.value.trim()) url.searchParams.set('q', input.value.trim()); else url.searchParams.delete('q'); window.history.replaceState({}, '', url); render(); });
    input.addEventListener('input', render);
    root.querySelectorAll('[data-full-scope]').forEach((button) => button.addEventListener('click', () => { scope = button.dataset.fullScope || 'all'; root.querySelectorAll('[data-full-scope]').forEach((item) => item.classList.toggle('is-active', item === button)); render(); }));
    if (input.value) render();
  })();
</script>
