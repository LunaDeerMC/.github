  BadgeInfo,
  BookOpen,
  Boxes,
  Check,
  ChevronDown,
  ChevronRight,
  CircleAlert,
  CircleHelp,
  Code2,
  Compass,
  Component,
  Copy,
  Download,
  ExternalLink,
  FileText,
  Filter,
  Github,
  Gift,
  Heart,
  KeyRound,
  LayoutGrid,
  Layers3,
  Link2,
  List,
  ListFilter,
  LockKeyhole,
  Mail,
  Menu,
  MessageCircle,
  Monitor,
  Moon,
  MoonStar,
  Package,
  PanelLeft,
  PanelRight,
  PlayCircle,
  Puzzle,
  ReceiptText,
  Search,
