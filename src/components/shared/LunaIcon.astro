  Sparkles,
  Sun,
  Tag,
  Terminal,
  User,
  Users,
  Workflow,
  Wrench,
  X,
} from "lucide-astro";

interface Props {
  name?: string;
  size?: number;
  strokeWidth?: number;
  label?: string;
  class?: string;
}

const iconMap = {
  Archive,
  ArrowDown,
  ArrowLeft,
  ArrowRight,
  ArrowUpRight,
  BadgeInfo,
  BookOpen,
  Boxes,
  Check,
  ChevronDown,
  ChevronRight,
  CircleAlert,
  CircleHelp,
  Code2,
  Compass,
  Component,
  Copy,
  Download,
  ExternalLink,
  FileText,
  Filter,
  Github,
  Gift,
  Heart,
  KeyRound,
  LayoutGrid,
  Layers3,
  Link2,
  List,
  ListFilter,
  LockKeyhole,
  Mail,
  Menu,
  MessageCircle,
  Monitor,
  Moon,
  MoonStar,
  Package,
  PanelLeft,
  PanelRight,
  PlayCircle,
  Puzzle,
  ReceiptText,
  Search,
  ScrollText,
  Scale,
  Server,
  Settings,
  Shield,
  ShieldCheck,
  SlidersHorizontal,
  Sparkles,
  Sun,
  Tag,
  Terminal,
  User,
  Users,
  Workflow,
  Wrench,
  X,
} as const;

const { name = "CircleHelp", size = 20, strokeWidth = 1.75, label, class: className } = Astro.props;
const iconName = name.replace(/^lucide:/, "").split(":").pop() ?? "CircleHelp";
const Icon = iconMap[iconName as keyof typeof iconMap] ?? CircleHelp;
---

<Icon size={size} strokeWidth={strokeWidth} class={className} aria-hidden={label ? undefined : "true"} aria-label={label} />
